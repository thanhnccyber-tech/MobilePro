<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="Chọn mã ưu đãi"
        android:textColor="@color/brown"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEmptyVouchers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="24dp"
        android:text="Hiện chưa có mã giảm giá nào"
        android:textColor="@color/brown_light"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerVouchers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="360dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseVoucherDialog"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Đóng"
        android:textColor="@color/brown"
        android:textStyle="bold"
        app:cornerRadius="23dp"
        app:strokeColor="@color/cream_border"
        app:strokeWidth="1.5dp" />

</LinearLayout>